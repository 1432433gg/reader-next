# Copy this file to .env.docker before running docker compose.
# Keep secrets out of git.

# Public container port on the host.
READER_PORT=18080

# Optional: pin a version instead of latest, e.g. ghcr.io/1432433gg/reader-next:x.y.z
READER_IMAGE=ghcr.io/1432433gg/reader-next:latest

# Reader config.
SECURE=false
SECURE_KEY=
INVITE_CODE=
USER_LIMIT=50
USER_BOOK_LIMIT=2000
LOG_LEVEL=info
REQUEST_TIMEOUT_SECS=15

# 书架新章节自动检查：间隔（小时，0 关闭）和同时检查的书源数
CHAPTER_UPDATE_INTERVAL_HOURS=24
CHAPTER_UPDATE_CONCURRENCY=3
